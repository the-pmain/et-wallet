{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo",

    /* Целевая среда: Node 22 LTS и новее. Не браузер. */
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    /* Импорты указывают расширение `.ts`: тот же исходник Node исполняет
       напрямую, стирая типы. Сборка в отдельный `dist` не нужна. */
    "allowImportingTsExtensions": true,

    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": true,
    "forceConsistentCasingInFileNames": true,

    /* Объявления типов зависимостей не проверяются: они принадлежат чужому
       коду, а расхождение версий @types/node с внутренними типами Fastify
       останавливало бы проверку, ни разу не указав на ошибку в нашем коде. */
    "skipLibCheck": true,

    /* Конструкции, требующие кодогенерации, запрещены: Node 22 и новее
       исполняет TypeScript, стирая типы, и enum либо namespace такой
       обработке не поддаются. */
    "erasableSyntaxOnly": true,

    "types": ["node"]
  },
  "include": ["server/src"]
}
