{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",

    /*
      Сквозные проверки выполняются в Node, но управляют браузером:
      `page.evaluate` исполняет код внутри страницы, и типы DOM ему нужны.

      Отдельный проект, а не расширение `tsconfig.node.json`, — потому
      что тот описывает сценарии сборки, которым DOM недоступен
      в принципе. Добавив DOM туда, мы разрешили бы обращаться
      к документу из плагинов Vite, где документа нет.
    */
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "erasableSyntaxOnly": true,

    /*
      Типы Playwright опираются на глобальные объявления DOM из своей
      поставки. Проверять их у себя незачем: чужие определения мы
      не правим, а сбой в них останавливал бы проверку нашего кода.
    */
    "skipLibCheck": true,

    "types": ["node"]
  },
  "include": ["playwright.config.ts", "e2e/**/*.ts"]
}
