{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",

    /*
      End-to-end checks run in Node but drive a browser:
      `page.evaluate` executes inside the page and needs DOM types.

      A separate project, not an extension of `tsconfig.node.json`,
      because that one describes build scripts that have no DOM at
      all. Adding DOM there would let Vite plugins reach for a
      document that does not exist.
    */
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "erasableSyntaxOnly": true,

    /*
      Playwright types rely on global DOM declarations from their
      own package. Checking them here is pointless: we do not edit
      other people's definitions, and a failure in them would stop
      the check of our code.
    */
    "skipLibCheck": true,

    "types": ["node"]
  },
  "include": ["playwright.config.ts", "e2e/**/*.ts"]
}
