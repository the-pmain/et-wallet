{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    /* Target environment: a modern browser. */
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "useDefineForClassFields": true,

    /* Modules: Vite bundles; TypeScript only checks types. */
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Maximum strictness. For a wallet a typing error can cost funds. */
    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": true,
    "forceConsistentCasingInFileNames": true,

    /* Dependency type declarations are not checked.
       Concrete reason: `@walletconnect/core` declares an event map
       that fails our strictness, and we cannot patch a third-party
       package. That does not weaken our own code — everything in
       `src` is still checked. */
    "skipLibCheck": true,

    /* Ban constructs that cannot be erased without codegen (enum, namespace).
       That keeps the sources compatible with transpilers and future TypeScript. */
    "erasableSyntaxOnly": true,

    /* Path aliases. The only alias in the project — see README, Aliases.
       baseUrl is omitted: it is deprecated in TypeScript 6 and removed in 7.
       Without it, paths in `paths` resolve relative to this file. */
    "paths": {
      "@/*": ["./src/*"]
    },

    "types": ["vite/client"]
  },
  "include": ["src"]
}
