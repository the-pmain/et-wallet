{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    /* Целевая среда: современный браузер. */
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "useDefineForClassFields": true,

    /* Модули: сборкой занимается Vite, TypeScript только проверяет типы. */
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Максимальная строгость. Для кошелька цена ошибки типизации — потеря средств. */
    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": true,
    "forceConsistentCasingInFileNames": true,

    /* Объявления типов зависимостей не проверяются.
       Причина конкретная: `@walletconnect/core` объявляет карту событий
       так, что она не проходит нашу строгость, и починить чужой пакет
       мы не можем. Строгость собственного кода это не ослабляет —
       проверяется всё, что написано в `src`. */
    "skipLibCheck": true,

    /* Запрет конструкций, которые нельзя стереть без кодогенерации (enum, namespace).
       Это гарантирует совместимость с транспиляторами и будущими версиями TypeScript. */
    "erasableSyntaxOnly": true,

    /* Алиасы путей. Единственный алиас на весь проект — см. README, раздел «Алиасы».
       baseUrl не задаётся: он объявлен устаревшим в TypeScript 6 и удаляется в 7.
       Без него пути в `paths` разрешаются относительно этого файла. */
    "paths": {
      "@/*": ["./src/*"]
    },

    "types": ["vite/client"]
  },
  "include": ["src"]
}
