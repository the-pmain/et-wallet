# Режим работы. В `production` часть настроек становится обязательной.
NODE_ENV=development

# Адрес и порт.
HOST=127.0.0.1
PORT=8080

# Источники, которым разрешены кросс-доменные запросы, через запятую.
# В боевом режиме переменная обязательна: сервис откажется стартовать без неё.
# Для расширения это адрес вида chrome-extension://<идентификатор>.
ALLOWED_ORIGINS=

# Ограничение частоты: сколько запросов с одного адреса за окно.
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# Предел размера тела запроса в байтах.
MAX_BODY_BYTES=65536

# Сколько секунд клиенту разрешено держать каталог в кэше.
CATALOG_CACHE_SECONDS=300
