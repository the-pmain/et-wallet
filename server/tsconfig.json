{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",

    /* Целевая среда: Node 22 LTS и новее. */
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "isolatedModules": true,

    /* Импорты указывают расширение `.ts`, а при сборке оно переписывается
       в `.js`. Это единственный способ иметь один исходник, который Node
       исполняет напрямую (стирая типы) и который же собирается в `dist`.
       Без переписывания собранный код искал бы несуществующие `.ts`. */
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,

    "outDir": "./dist",
    "rootDir": "./src",
    "sourceMap": true,
    "declaration": false,

    /* Та же строгость, что и у расширения: сервис отдаёт данные, по которым
       кошелёк показывает адреса контрактов, и цена ошибки типизации здесь
       не ниже. */
    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": true,
    "forceConsistentCasingInFileNames": true,

    /* Объявления типов зависимостей не проверяются: они принадлежат чужому
       коду, чинить их мы не можем, а расхождение версий @types/node
       с внутренними типами Fastify останавливало бы сборку сервиса,
       ни разу не указав на ошибку в нашем коде. */
    "skipLibCheck": true,

    /* Конструкции, требующие кодогенерации, запрещены: Node 22 и новее
       исполняет TypeScript, стирая типы, и enum либо namespace такой
       обработке не поддаются. Один и тот же исходник обязан работать
       и после сборки, и напрямую. */
    "erasableSyntaxOnly": true,

    "types": ["node"]
  },
  "include": ["src"]
}
